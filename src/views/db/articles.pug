doctype html
html(lang="uk")
  head
    meta(charset="utf-8")
    meta(name="viewport", content="width=device-width, initial-scale=1")
    title= title
    link(rel="icon", href="/favicon.ico")
    link(rel="stylesheet", href="/style.css")
  body
    h1= title

    if !articles || articles.length === 0
      p Немає даних у колекції articles.
      p Додай документи в MongoDB Atlas і онови сторінку.
    else
      ul
        each a in articles
          li
            strong= a.title
            if a.text
              div= a.text
            small createdAt: #{a.createdAt}
